# =============================================================================
# Photoblog — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# ----- Database (PostgreSQL) -----
# Used by Prisma. Docker Compose provides a local instance by default.
DATABASE_URL="postgresql://photoblog:photoblog@localhost:5432/photoblog?schema=public"

# ----- Server -----
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Session secret — generate a long random string for production
# Example: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# ----- Admin bootstrap (used only on first seed / setup) -----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# ----- Cloudinary (image storage) -----
# Create a free account at https://cloudinary.com and copy these from the dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix inside your Cloudinary account
CLOUDINARY_FOLDER=photoblog

# ----- Optional email (contact form) -----
# Leave empty in development; contact messages are stored in DB only.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO_EMAIL=you@example.com
